# Google Gemini API (Lấy tại Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Google Cloud Platform (Tùy chọn: nếu để trống sẽ tự động dùng MemoryRepo + lưu file local để chạy ngay)
GCP_PROJECT=
GCS_BUCKET=

# Cấu hình hộ kinh doanh mẫu Đà Nẵng
DEMO_HOUSEHOLD_ID=demo
MAX_UPLOAD_MB=8
